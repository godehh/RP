<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Stylesheets -->
  {{ 'main.css' | asset_url | stylesheet_tag }}
  {{ 'header-footer.css' | asset_url | stylesheet_tag }}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
  {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  <!-- Header & Announcement Section -->
  {% section 'header' %}

  <!-- Main Content -->
  <main id="MainContent" class="content-for-layout" role="main">
    {{ content_for_layout }}
  </main>

  <!-- Slide-out Cart Drawer -->
  {% section 'cart-drawer' %}

  <!-- Footer Section -->
  {% section 'footer' %}

  <!-- Core Scripts -->
  {{ 'products-data.js' | asset_url | script_tag }}
  {{ 'store.js' | asset_url | script_tag }}
  {{ 'components.js' | asset_url | script_tag }}
  {{ 'main.js' | asset_url | script_tag }}
</body>
</html>
