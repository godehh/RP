{% comment %}
  Shopify Section: Featured Products Grid
{% endcomment %}

<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="sub-badge">{{ section.settings.badge }}</span>
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>

    <div class="products-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Sub Badge",
      "default": "Staff Picks"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Organic Essentials"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Our most cherished kitchen superfoods, stone-ground to perfection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
